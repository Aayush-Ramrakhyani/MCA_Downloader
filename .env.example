# ──────────────────────────────────────────────────────────────
# MCA Document Downloader — Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Finanvo API base URL (do not change unless the service migrates)
FINANVO_BASE_URL=https://api5.finanvo.in

# Your Finanvo account credentials — NEVER hardcode these
FINANVO_EMAIL=
FINANVO_PASSWORD=

# ──────────────────────────────────────────────────────────────
# TOKEN EXTRACTION CONFIG
# After capturing the login response in DevTools, set the path
# to the token field inside the JSON response.
# Examples:
#   FINANVO_TOKEN_PATH=token
#   FINANVO_TOKEN_PATH=data.token
#   FINANVO_TOKEN_PATH=data.access_token
# ──────────────────────────────────────────────────────────────
FINANVO_TOKEN_PATH=token

# JWT secret for our own session tokens (generate a long random string)
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=8h

# CORS — frontend origin
CLIENT_URL=http://localhost:5173

# Local downloads directory (relative to backend/)
DOWNLOADS_DIR=./downloads

# Database file path (relative to backend/)
DB_PATH=./data/db.json

# Request timeout for Finanvo API calls (ms)
FINANVO_TIMEOUT_MS=30000

# Download queue concurrency (max parallel downloads)
DOWNLOAD_CONCURRENCY=3

# Debug mode — logs sanitized request/response data (never logs tokens or passwords)
DEBUG_API=false
